    "version": "0.2.0",
    "configurations": [
    {
        "name": "GDB app",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/strategic_combat_simulation",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "preLaunchTask": "build",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "GDB test",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/strategic_combat_simulation_tests",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "preLaunchTask": "build",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}